class UsageError(Exception):
    """Bad input from the caller: exit 2 with the message on stderr."""


def fail(msg, code=2):
    print(f"orca-slice: {msg}", file=sys.stderr)
    sys.exit(code)


# ---------------------------------------------------------------- the binary

def orca_env():
    env = dict(os.environ, LC_ALL="C", LIBGL_ALWAYS_SOFTWARE="1",
               GALLIUM_DRIVER="llvmpipe", MESA_GL_VERSION_OVERRIDE="3.3")
    # never let the slicer try a display: everything here is headless
    env.pop("DISPLAY", None)
    env.pop("WAYLAND_DISPLAY", None)
    return env


_HELP = {}


def binary_help():
    if "text" not in _HELP:
        try:
            _HELP["text"] = subprocess.run([ORCA_BIN, "--help"], capture_output=True, text=True,
                                           env=orca_env(), timeout=60).stdout
        except Exception:
            _HELP["text"] = ""
    return _HELP["text"]


def binary_has(flag):
    return re.search(r"(^|\s)" + re.escape(flag) + r"\b", binary_help(), re.M) is not None


def need_flag(flag, feature):
    if not binary_has(flag):
        raise UsageError(f"{feature} needs a fork binary with {flag} (ORCA_DIR={ORCA_DIR}); "
                         "rebuild the fork from claude/headless-cli or later")


def load_catalog():
    """{key: entry} from `orca-slicer --list-options -`, cached per binary build; None if unsupported."""
    try:
        st = os.stat(ORCA_BIN)
    except OSError:
        return None
    tag = hashlib.sha1(f"{os.path.realpath(ORCA_BIN)}:{st.st_mtime_ns}:{st.st_size}".encode()).hexdigest()[:16]
    path = os.path.join(CACHE_DIR, f"catalog-{tag}.json")
    data = None
    if os.path.isfile(path):
        try:
            data = json.load(open(path, encoding="utf-8"))
        except Exception:
            data = None
    if data is None:
        if not binary_has("--list-options"):
            return None
        try:
            out = subprocess.run([ORCA_BIN, "--list-options", "-"], capture_output=True, text=True,
                                 env=orca_env(), timeout=120).stdout
            data = json.loads(out[out.index("{"):])
        except Exception:
            return None
        try:
            os.makedirs(CACHE_DIR, exist_ok=True)
            tmp = path + f".{os.getpid()}"
            json.dump(data, open(tmp, "w", encoding="utf-8"))
            os.replace(tmp, path)
        except OSError:
            pass
    cat = {o["key"]: o for o in data.get("options", [])}
    cat["__cli__"] = data.get("cli", {})
    return cat


def did_you_mean(key, keys):
    m = difflib.get_close_matches(key, [k for k in keys if not k.startswith("__")], n=3, cutoff=0.6)
    return f" (did you mean {', '.join(m)}?)" if m else ""


def check_enum(entry, value, where):
    """Reject enum values the slicer would silently replace."""
    if entry.get("type") not in ("enum", "enums") or not entry.get("enum_values"):
        return
    allowed = entry["enum_values"]
    vals = [v.strip() for v in str(value).split(",")] if entry["type"] == "enums" else [str(value).strip()]
    bad = [v for v in vals if v not in allowed]
    if bad:
        raise UsageError(f"{where}: {entry['key']}={bad[0]!r} is not a valid value; allowed: {', '.join(allowed)}")


# ---------------------------------------------------------------- presets

def list_presets():
    out = {"machine": [], "process": [], "filament": []}
    for root in (flatten.BUNDLE, flatten.HUB_CACHE):
        for sub, kind in (("machine", "machine"), ("printer", "machine"),
                          ("process", "process"), ("filament", "filament")):
            for p in glob.glob(os.path.join(root, sub, "*.json")):
                try:
                    n = json.load(open(p, encoding="utf-8")).get("name")
                except Exception:
                    continue
                if n:
                    out[kind].append(n)
    for k in out:
        print(f"{k}:")
        for n in sorted(set(out[k]), key=str.lower):
            print(f"  {n}")


def user_presets(kind):
    """{name: path} of the presets orca-slice can use for kind (filament/process/machine)."""
    subs = {"machine": ("machine", "printer"), "process": ("process",), "filament": ("filament",)}[kind]
    found = {}
    for root in (flatten.HUB_CACHE, flatten.BUNDLE):  # bundle last: it wins
        for sub in subs:
            for p in glob.glob(os.path.join(root, sub, "*.json")):
                try:
                    n = json.load(open(p, encoding="utf-8")).get("name")
                except Exception:
                    continue
                if n:
                    found[n] = p
    return found


def retool(path, tool):
    """T0 / TOOL=0 -> T<tool> on executable lines (single-colour Trad Rack lane)."""
    n, lines = 0, []
    with open(path, encoding="utf-8", errors="replace") as fh:
        for line in fh:
            if not line.lstrip().startswith(";"):
                new = re.sub(r"\bTOOL=0\b", f"TOOL={tool}", line)
                new = re.sub(r"^(\s*)T0\b", rf"\g<1>T{tool}", new)
                n += new != line
                line = new
            lines.append(line)
    with open(path, "w", encoding="utf-8") as fh:
        fh.writelines(lines)
    return n


def stats(path):
    got = {}
    with open(path, encoding="utf-8", errors="replace") as fh:
        for line in fh:
            if not line.startswith(";"):
                continue
            for needle, key in STAT_KEYS.items():
                if key not in got:
                    m = re.match(r"\s*;\s*" + re.escape(needle) + r"\s*[:=]\s*(.+)", line)
                    if m:
                        got[key] = m.group(1).strip()
    return got


# ---------------------------------------------------------------- --set routing

SET_RE = re.compile(r"^\s*([A-Za-z0-9_]+)\s*(?:\[\s*(\d+)\s*\])?\s*=(.*)$", re.S)


def parse_set(item):
    m = SET_RE.match(item)
    if not m:
        raise UsageError(f"--set needs KEY=VALUE or KEY[i]=VALUE, got {item!r}")
    key, idx, value = m.group(1), m.group(2), m.group(3)
    if idx is not None and int(idx) < 1:
        raise UsageError(f"--set {item!r}: indices start at 1")
    return key, (int(idx) if idx is not None else None), value


def _as_list(v):
    return v if isinstance(v, list) else [v]


def _set_vector(cur, idx, value):
    """Set element idx (1-based) of a preset list value, padding with the last element."""
    cur = list(_as_list(cur)) if cur not in (None, "") else []
    if not cur:
        cur = [value]
    while len(cur) < idx:
        cur.append(cur[-1])
    cur[idx - 1] = value
    return cur


def route_sets(sets, catalog, machine, process, filaments, notes):
    """Apply --set items to the flattened preset dicts; return extra native CLI args.
    sets: [(key, idx, value)]. Raises UsageError on unknown keys / bad indices / bad enums."""
    native = []
    fallback_noted = False
    for key, idx, value in sets:
        where = f"--set {key}" + (f"[{idx}]" if idx else "")
        if catalog is not None:
            entry = catalog.get(key)
            if entry is None or key.startswith("__"):
                raise UsageError(f"{where}: unknown setting{did_you_mean(key, catalog)} (see orca-slice options --search)")
            check_enum(entry, value, where)
            preset = entry.get("preset")
            vector = bool(entry.get("vector"))
        else:
            if not fallback_noted:
                notes.append("this slicer binary has no --list-options: --set keys found in the printer or filament "
                             "preset go there, everything else into the process preset (unchecked)")
                fallback_noted = True
            if key in machine:
                preset = "printer"
            elif filaments and key in filaments[0]:
                preset = "filament"
            else:
                preset = "process"
            vector = isinstance((machine.get(key) if preset == "printer" else
                                 filaments[0].get(key) if preset == "filament" else process.get(key)), list)
        if preset == "process":
            if idx is not None:
                if not vector:
                    raise UsageError(f"{where}: {key} is not a list setting, drop the [{idx}]")
                process[key] = _set_vector(process.get(key), idx, value)
            else:
                process[key] = value.split(",") if vector and isinstance(process.get(key), list) else value
        elif preset == "filament":
            targets = range(len(filaments))
            if idx is not None:
                if idx > len(filaments):
                    raise UsageError(f"{where}: there are only {len(filaments)} filament(s)")
                targets = [idx - 1]
            for i in targets:
                f = filaments[i]
                f[key] = value.split(",") if vector else value
        elif preset == "printer":
            if idx is not None:
                if not vector:
                    raise UsageError(f"{where}: {key} is not a per-extruder setting, drop the [{idx}]")
                machine[key] = _set_vector(machine.get(key), idx, value)
            else:
                machine[key] = value.split(",") if vector else value
        else:  # project or no preset: the slicer's own --key value (highest priority)
            if idx is not None:
                raise UsageError(f"{where}: {key} is a project setting; give the whole value, e.g. --set {key}=a,b")
            native += ["--" + key.replace("_", "-"), value]
    return native


# ---------------------------------------------------------------- jobs from flags

def _settings_list(text, where, catalog, scope):
    """'k=v,k=v' (a value may contain commas: they stay with the previous key) -> dict, checked."""
    out, last = {}, None
    for tok in text.split(","):
        if "=" in tok:
            k, v = tok.split("=", 1)
            k = k.strip()
            out[k] = v
            last = k
        elif last is not None:
            out[last] += "," + tok
        else:
            raise UsageError(f"{where}: expected KEY=VALUE, got {tok!r}")
    for k, v in out.items():
        check_scope(k, v, scope, where, catalog)
    return out


SCOPE_WORD = {"object": "per object", "part": "per modifier/part", "layer_range": "per height range",
              "plate": "per plate", "global": "globally"}


def check_scope(key, value, scope, where, catalog):
    if catalog is None:
        return  # the binary validates the job itself
    entry = catalog.get(key)
    if entry is None or key.startswith("__"):
        raise UsageError(f"{where}: unknown setting {key!r}{did_you_mean(key, catalog)}")
    if scope not in entry.get("scopes", []):
        hint = f" (it is a {entry['preset']} setting: use --set)" if entry.get("preset") else ""
        raise UsageError(f"{where}: {key} can't be set {SCOPE_WORD[scope]}{hint}")
    check_enum(entry, value, where)


def _floats(text, n, where):
    try:
        vals = [float(x) for x in text.split(",")]
    except ValueError:
        vals = []
    if len(vals) not in (n if isinstance(n, tuple) else (n,)):
        raise UsageError(f"{where}: expected {n if not isinstance(n, tuple) else ' or '.join(map(str, n))} "
                         f"comma-separated numbers, got {text!r}")
    return vals


def parse_shape(spec, where, catalog, with_settings):
    """SHAPE@X,Y,Z:SIZE[:KEY=VALUE,...] -> job part dict (without type)."""
    m = re.match(r"^\s*(box|cylinder|cone|sphere)\s*@([^:]+):([^:]+)(?::(.*))?$", spec, re.S)
    if not m:
        raise UsageError(f"{where}: expected SHAPE@X,Y,Z:SIZE[:KEY=VALUE,...] with SHAPE box, cylinder, cone or sphere, "
                         f"got {spec!r}")
    shape, pos, size, settings = m.groups()
    part = {"position": _floats(pos, 3, where + " position")}
    if shape == "box":
        part["primitive"] = {"shape": "box", "size": _floats(size, 3, where + " size")}
    elif shape in ("cylinder", "cone"):
        r, h = _floats(size, 2, where + " size")
        part["primitive"] = {"shape": shape, "radius": r, "height": h}
    else:
        part["primitive"] = {"shape": "sphere", "radius": _floats(size, 1, where + " size")[0]}
    if settings:
        if not with_settings:
            raise UsageError(f"{where}: negative volumes take no settings")
        part["settings"] = _settings_list(settings, where, catalog, "part")
    return part


def job_from_flags(a, model, catalog):
    """Build a one-plate job around `model` from the per-object flags; None if none were given."""
    if not (a.set_object or a.set_range or a.modifier or a.negative or a.cut or a.copies):
        return None
    obj = {"file": model}
    name = os.path.splitext(os.path.basename(model))[0]
    settings = {}
    for item in a.set_object:
        lhs, _, value = item.partition("=")
        if not _:
            raise UsageError(f"--set-object needs [NAME:]KEY=VALUE, got {item!r}")
        if ":" in lhs:
            oname, key = lhs.split(":", 1)
            if oname != name:
                raise UsageError(f"--set-object {item!r}: no object named {oname!r} (the object is {name!r}; "
                                 "use a job file for several objects)")
        else:
            key = lhs
        key = key.strip()
        check_scope(key, value, "object", f"--set-object {item!r}", catalog)
        settings[key] = value
    if settings:
        obj["settings"] = settings
    ranges = []
    for item in a.set_range:
        m = re.match(r"^\s*([0-9.]+)\s*-\s*([0-9.]+)\s*:(.+)$", item, re.S)
        if not m:
            raise UsageError(f"--set-range needs Z0-Z1:KEY=VALUE[,KEY=VALUE], got {item!r}")
        z0, z1 = float(m.group(1)), float(m.group(2))
        if z1 <= z0:
            raise UsageError(f"--set-range {item!r}: Z1 must be above Z0")
        s = _settings_list(m.group(3), f"--set-range {item!r}", catalog, "layer_range")
        for r in ranges:  # same range given twice: merge
            if r["min_z"] == z0 and r["max_z"] == z1:
                r["settings"].update(s)
                break
        else:
            ranges.append({"min_z": z0, "max_z": z1, "settings": s})
    if ranges:
        obj["height_ranges"] = ranges
    parts = []
    for spec in a.modifier:
        p = parse_shape(spec, f"--modifier {spec!r}", catalog, True)
        p["type"] = "modifier"
        parts.append(p)
    for spec in a.negative:
        p = parse_shape(spec, f"--negative {spec!r}", catalog, False)
        p["type"] = "negative"
        parts.append(p)
    if parts:
        obj["parts"] = parts
    if a.cut:
        m = re.match(r"^\s*([0-9.]+)\s*(?::\s*(upper|lower|both))?\s*$", a.cut)
        if not m:
            raise UsageError(f"--cut needs Z[:upper|lower|both], got {a.cut!r}")
        obj["cut"] = {"z": float(m.group(1)), "keep": m.group(2) or "both"}
    if a.copies:
        if a.copies < 1:
            raise UsageError("--copies must be >= 1")
        obj["count"] = a.copies
    rot = [a.rotate_x or 0.0, a.rotate_y or 0.0, a.rotate or 0.0]
    if any(rot):
        obj["rotate"] = rot
    if a.lay_flat:
        obj["lay_on"] = "largest_face"
    if a.scale:
        obj["scale"] = a.scale
    if a.orient:
        obj["orient"] = True
    if a.no_arrange:
        raise UsageError("--no-arrange can't be combined with per-object options; use a job file with positions")
    return {"version": 1, "objects": [obj]}


# ---------------------------------------------------------------- lanes (Moonraker, read only)

def http_json(url, headers=None, data=None, method=None, timeout=10):
    req = urllib.request.Request(url, headers=dict(headers or {}), method=method,
                                 data=json.dumps(data).encode() if data is not None else None)
    if data is not None:
        req.add_header("Content-Type", "application/json")
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            body = r.read().decode("utf-8", "replace")
            return r.status, (json.loads(body) if body.strip() else None)
    except urllib.error.HTTPError as e:
        body = e.read().decode("utf-8", "replace")
        try:
            return e.code, json.loads(body)
        except ValueError:
            return e.code, {"detail": body}


def match_preset(name, available):
    """Exact name, else whitespace/case-insensitive match. -> (preset or None, 'exact'|'fuzzy'|None)."""
    if not name:
        return None, None
    if name in available:
        return name, "exact"
    norm = lambda s: re.sub(r"\s+", " ", s).strip().lower()  # noqa: E731
    for n in available:
        if norm(n) == norm(name):
            return n, "fuzzy"
    return None, None


def parse_lanes(payload, available):
    """Moonraker lane_data database payload -> sorted lane list."""
    value = ((payload or {}).get("result") or {}).get("value") or {}
    lanes = []
    for key, d in value.items():
        if not isinstance(d, dict):
            continue
        try:
            idx = int(str(d.get("lane", "")).strip())
        except ValueError:
            m = re.match(r"^T(\d+)$", key)
            if not m:
                continue
            idx = int(m.group(1))
        preset, how = match_preset(d.get("orca_preset") or d.get("name") or "", available)
        lanes.append({
            "tool": f"T{idx}", "lane": idx, "material": d.get("material"), "color": d.get("color"),
            "name": d.get("name"), "spool_id": d.get("spool_id"),
            "spoolman_filament_id": d.get("spoolman_filament_id"), "orca_preset": d.get("orca_preset"),
            "nozzle_temp": d.get("nozzle_temp"), "bed_temp": d.get("bed_temp"),
            "preset": preset, "preset_match": how,
        })
    return sorted(lanes, key=lambda x: x["lane"])


def fetch_lanes():
    base = os.environ.get("MOONRAKER_URL", DEFAULT_MOONRAKER).rstrip("/")
    headers = {}
    if os.environ.get("MOONRAKER_API_KEY"):
        headers["X-Api-Key"] = os.environ["MOONRAKER_API_KEY"]
    try:
        status, payload = http_json(base + "/server/database/item?namespace=lane_data", headers)
    except Exception as e:
        raise UsageError(f"can't read lane_data from Moonraker at {base}: {e}")
    if status != 200:
        raise UsageError(f"Moonraker at {base} answered HTTP {status} for lane_data")
    return base, parse_lanes(payload, user_presets("filament"))


def resolve_lane_filaments(fils, lane_given):
    """-f @T7 / @printer -> preset names; returns (names, tool to retool to or None)."""
    if not any(f.startswith("@") for f in fils):
        return fils, None
    _, lanes = fetch_lanes()
    by_tool = {l["tool"]: l for l in lanes}
    out, tool = [], None
    for f in fils:
        if f == "@printer":
            top = max([l["lane"] for l in lanes] + [-1])
            for i in range(top + 1):
                l = by_tool.get(f"T{i}")
                if l and l["preset"]:
                    out.append(l["preset"])
                else:
                    print(f"orca-slice: T{i} has no usable filament preset "
                          f"({(l or {}).get('orca_preset')!r}); using {DEFAULT_FILAMENT!r}", file=sys.stderr)
                    out.append(DEFAULT_FILAMENT)
        elif re.match(r"^@T\d+$", f):
            l = by_tool.get(f[1:])
            if not l:
                raise UsageError(f"-f {f}: nothing is loaded in {f[1:]} (lanes: {', '.join(by_tool) or 'none'})")
            if not l["preset"]:
                raise UsageError(f"-f {f}: {f[1:]} holds {l.get('orca_preset')!r}, which is not one of the presets")
            out.append(l["preset"])
            tool = l["lane"]
        else:
            if f.startswith("@"):
                raise UsageError(f"-f {f}: use @T<n> or @printer")
            out.append(f)
    if len(out) != 1 or lane_given:
        tool = None
    return out, tool


# ---------------------------------------------------------------- hub

HUB_TYPES = {"filament": "filament", "process": "print", "machine": "printer"}
HUB_TYPES_BACK = {v: k for k, v in HUB_TYPES.items()}


def hub_conn():
    url = os.environ.get("FILAMENT_HUB_URL", "").strip()
    if not url:
        try:
            url = json.load(open(os.path.expanduser("~/.config/OrcaSlicer/OrcaSlicer.conf"))).get("app", {}).get(
                "filament_hub_url", "")
        except Exception:
            url = ""
    if not url:
        raise UsageError("no hub URL: set FILAMENT_HUB_URL (or filament_hub_url in OrcaSlicer's preferences)")
    token = os.environ.get("FILAMENT_HUB_TOKEN", "").strip()
    return url.rstrip("/"), token


def hub_call(path, method="GET", data=None, need_token=True):
    url, token = hub_conn()
    headers = {}
    if need_token:
        if not token:
            raise UsageError("set FILAMENT_HUB_TOKEN in the environment (tokens are never read from or written to files)")
        headers["Authorization"] = "Bearer " + token
    try:
        return http_json(url + path, headers, data=data, method=method, timeout=20)
    except Exception as e:
        raise UsageError(f"hub at {url} unreachable: {e}")


def hub_ok(status, body, what):
    if status == 401:
        raise UsageError(f"hub refused the token ({what}: HTTP 401)")
    if status >= 400:
        raise UsageError(f"hub {what} failed: HTTP {status} {json.dumps(body)[:300]}")
    return body


def _safe_name(name):
    return re.sub(r"[^A-Za-z0-9 ._@()+-]", "_", name).strip() or "preset"


def cmd_hub(argv):
    ap = argparse.ArgumentParser(prog="orca-slice hub", description="Filament hub: list, pull and push presets, inventory. "
                                 "URL from FILAMENT_HUB_URL (else OrcaSlicer's filament_hub_url); token only from "
                                 "FILAMENT_HUB_TOKEN. pull writes to ~/.cache/orca-slice/hub, never to the desktop presets.")
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("status", help="hub health and the token's user")
    p = sub.add_parser("list", help="hub presets (no content)")
    p.add_argument("--type", choices=list(HUB_TYPES))
    p = sub.add_parser("pull", help="download hub presets into the orca-slice hub cache")
    p.add_argument("--type", choices=list(HUB_TYPES))
    p.add_argument("--name", help="only this preset")
    p = sub.add_parser("push", help="upload a local preset (create or update by name)")
    p.add_argument("name")
    p.add_argument("--type", choices=list(HUB_TYPES), default="filament")
    p.add_argument("--force", action="store_true", help="overwrite even if the hub copy changed since")
    sub.add_parser("inventory", help="owned filaments (Spoolman via the hub)")
    a = ap.parse_args(argv)
    url, _ = hub_conn()

    if a.cmd == "status":
        st, health = hub_call("/api/v1/health", need_token=False)
        out = {"hub": url, "health": health if st == 200 else {"http": st}}
        if os.environ.get("FILAMENT_HUB_TOKEN"):
            st, me = hub_call("/api/v1/me")
            out["user"] = me if st == 200 else {"http": st}
        else:
            out["user"] = None
            out["note"] = "FILAMENT_HUB_TOKEN not set"
        print(json.dumps(out, indent=1))
        return 0
    if a.cmd == "list":
        q = f"?type={HUB_TYPES[a.type]}" if a.type else ""
        body = hub_ok(*hub_call("/api/v1/profiles" + q), "list")
        for p in body:
            p["kind"] = HUB_TYPES_BACK.get(p.get("type"), p.get("type"))
        print(json.dumps({"hub": url, "presets": body}, indent=1))
        return 0
    if a.cmd == "inventory":
        body = hub_ok(*hub_call("/api/v1/inventory?owned=true"), "inventory")
        print(json.dumps({"hub": url, "owned": body}, indent=1))
        return 0
    if a.cmd == "pull":
        q = f"?type={HUB_TYPES[a.type]}" if a.type else ""
        listing = hub_ok(*hub_call("/api/v1/profiles" + q), "list")
        written = []
        for p in listing:
            if a.name and p.get("name") != a.name:
                continue
            kind = HUB_TYPES_BACK.get(p.get("type"))
            if not kind:
                continue
            full = hub_ok(*hub_call("/api/v1/profiles/" + urllib.parse.quote(p["id"], safe="")), "get")
            content = full.get("content") or {}
            content["name"] = p["name"]
            d = os.path.join(flatten.HUB_CACHE, kind)
            os.makedirs(d, exist_ok=True)
            path = os.path.join(d, _safe_name(p["name"]) + ".json")
            with open(path, "w", encoding="utf-8") as fh:
                json.dump(content, fh, indent=1, ensure_ascii=False)
            meta = {"id": p["id"], "updated_time": p.get("updated_time"), "hub": url}
            json.dump(meta, open(path[:-5] + ".hubmeta", "w"), indent=1)
            written.append({"name": p["name"], "kind": kind, "path": path, "id": p["id"],
                            "updated_time": p.get("updated_time")})
        if a.name and not written:
            raise UsageError(f"hub pull: no preset named {a.name!r} on the hub")
        print(json.dumps({"hub": url, "cache": flatten.HUB_CACHE, "pulled": written}, indent=1))
        return 0
    if a.cmd == "push":
        local = user_presets(a.type).get(a.name)
        if not local:
            raise UsageError(f"hub push: no local {a.type} preset named {a.name!r} (see orca-slice --list)")
        content = json.load(open(local, encoding="utf-8"))
        listing = hub_ok(*hub_call(f"/api/v1/profiles?type={HUB_TYPES[a.type]}"), "list")
        same = [p for p in listing if p.get("name") == a.name]
        body = {"name": a.name, "content": content}
        if same:
            body["id"], body["original_updated_time"] = same[0]["id"], same[0].get("updated_time")
        else:
            body["id"] = str(uuid.uuid4())
        st, resp = hub_call("/api/v1/sync/force-push" if a.force else "/api/v1/sync/push", "POST", body)
        if st == 409:
            print(json.dumps({"hub": url, "status": "conflict", "name": a.name, **(resp or {})}, indent=1))
            print("orca-slice: hub push conflict: the hub copy changed; pull it, or push again with --force",
                  file=sys.stderr)
            return 3
        resp = hub_ok(st, resp, "push")
        print(json.dumps({"hub": url, "status": "ok", "created": not same, "source": local, "profile": resp}, indent=1))
        return 0
    return 2


