def cmd_options(argv):
    ap = argparse.ArgumentParser(prog="orca-slice options", description="The slicer's setting catalog as JSON: "
                                 "type, default, allowed values, and where each setting can be set.")
    ap.add_argument("--search", help="substring of key, label, category or tooltip (case-insensitive)")
    ap.add_argument("--key", action="append", default=[], help="exact key (repeatable)")
    ap.add_argument("--scope", choices=["global", "object", "part", "layer_range", "plate"])
    ap.add_argument("--preset", choices=["process", "filament", "printer", "project"])
    ap.add_argument("--cli", action="store_true", help="list the slicer's own command line options instead")
    a = ap.parse_args(argv)
    cat = load_catalog()
    if cat is None:
        need_flag("--list-options", "orca-slice options")
        raise UsageError(f"the slicer at {ORCA_BIN} lists --list-options but didn't produce a catalog")
    if a.cli:
        print(json.dumps(cat["__cli__"], indent=1))
        return 0
    out = []
    for k, e in cat.items():
        if k.startswith("__"):
            continue
        if a.key and k not in a.key:
            continue
        if a.scope and a.scope not in e.get("scopes", []):
            continue
        if a.preset and e.get("preset") != a.preset:
            continue
        if a.search:
            hay = " ".join(str(e.get(f, "")) for f in ("key", "label", "category", "tooltip")).lower()
            if a.search.lower() not in hay:
                continue
        out.append(e)
    missing = [k for k in a.key if k not in cat]
    if missing:
        raise UsageError(f"unknown setting {missing[0]!r}{did_you_mean(missing[0], cat)}")
    print(json.dumps(out, indent=1))
    return 0


