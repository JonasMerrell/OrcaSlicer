def make_datadir(work):
    datadir = os.path.join(work, "datadir")   # keep the CLI off the desktop config
    os.makedirs(datadir)
    # the fork's CLI resolves `inherits` through a PresetBundle loaded from
    # <datadir>/system, which the GUI normally fills on first start
    os.symlink(os.path.join(ORCA_DIR, "resources", "profiles"), os.path.join(datadir, "system"))
    # ...and only loads the vendors enabled in <datadir>/OrcaSlicer.conf: copy the
    # desktop's enabled models (just those, no tokens), Voron 0.1 if there are none
    models = [{"vendor": "Voron", "model": "Voron 0.1", "nozzle_diameter": "0.4"}]
    try:
        models = json.load(open(os.path.expanduser("~/.config/OrcaSlicer/OrcaSlicer.conf"))).get("models") or models
    except Exception:
        pass
    json.dump({"firstguide": {"finish": True}, "models": models},
              open(os.path.join(datadir, "OrcaSlicer.conf"), "w"))
    return datadir


def cmd_inspect(argv):
    ap = argparse.ArgumentParser(prog="orca-slice inspect", description="Mesh facts as JSON (bounding boxes, faces it "
                                 "can lie on), or with --paint the paint stored in a 3MF.")
    ap.add_argument("model")
    ap.add_argument("--paint", action="store_true")
    a = ap.parse_args(argv)
    flag = "--inspect-paint" if a.paint else "--inspect-mesh"
    need_flag(flag, "orca-slice inspect")
    model = os.path.abspath(a.model)
    if not os.path.isfile(model):
        raise UsageError(f"no such file: {a.model}")
    work = tempfile.mkdtemp(prefix="orca-slice-")
    try:
        datadir = make_datadir(work)
        r = subprocess.run([ORCA_BIN, "--datadir", datadir, flag, model], capture_output=True, text=True,
                           env=orca_env(), timeout=600)
        out = r.stdout
        start = min([i for i in (out.find("{"), out.find("[")) if i >= 0] or [-1])
        if r.returncode != 0 or start < 0:
            print(r.stderr[-2000:], file=sys.stderr)
            fail(f"inspect failed (exit {r.returncode})", 1)
        print(out[start:].strip())
        return 0
    finally:
        shutil.rmtree(work, ignore_errors=True)


