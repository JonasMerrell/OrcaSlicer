def output_base(a, src):
    base = os.path.splitext(os.path.basename(src))[0]
    if a.output and (a.output.endswith(os.sep) or os.path.isdir(a.output)):
        final = os.path.join(os.path.abspath(a.output), base + ".gcode")
    elif a.output:
        final = os.path.abspath(a.output)
    else:
        final = os.path.join(os.path.dirname(src), base + ".gcode")
    return final


def run_slice(a, mode, model=None, job=None, calib=None):
    """mode: model | job | calib. Returns exit code; prints the JSON result."""
    if not os.access(ORCA_BIN, os.X_OK):
        fail(f"OrcaSlicer fork binary not found at {ORCA_BIN}", 1)
    catalog = None if a.as_is else load_catalog()
    notes = []

    lane = a.lane
    fils_in = a.filament or [DEFAULT_FILAMENT]
    fils, lane_tool = resolve_lane_filaments(fils_in, lane is not None)
    if lane is None:
        lane = lane_tool + 1 if lane_tool is not None else 1

    if mode == "model" and not a.as_is:
        if a.job:
            raise UsageError("give either a model or --job")
        job = job_from_flags(a, model, catalog)
        if job is not None:
            mode = "job"
    if mode == "job":
        need_flag("--load-job", "a job file (or --set-object, --set-range, --modifier, --negative, --cut, --copies)")
        if a.as_is:
            raise UsageError("--as-is slices a 3MF as saved; it can't take a job")
        if a.no_arrange and job is None:
            raise UsageError("--no-arrange doesn't apply to job files: set \"arrange\" per plate")
    if mode == "calib":
        need_flag("--calib", "orca-slice calib")

    src = model if mode == "model" else (job if isinstance(job, str) else model) if mode == "job" else \
        os.path.join(os.getcwd(), f"calib_{calib[0]}.gcode")
    final = output_base(a, src)
    os.makedirs(os.path.dirname(final), exist_ok=True)

    work = tempfile.mkdtemp(prefix="orca-slice-")
    outdir = os.path.join(work, "out")
    os.makedirs(outdir)
    datadir = make_datadir(work)
    cmd = [ORCA_BIN, "--datadir", datadir]
    if a.html:
        cmd.append("--export-gcode-html")   # plate_N.html next to plate_N.gcode in outdir
    if a.stats:
        need_flag("--export-statistics", "--stats")
        cmd.append("--export-statistics")
    if a.strict:
        need_flag("--strict", "--strict")
        cmd.append("--strict")
    proc = {}
    try:
        if a.as_is:
            if not model.lower().endswith(".3mf"):
                raise UsageError("--as-is needs a .3mf")
            if a.set:
                print("orca-slice: note: --as-is slices the 3MF's own settings; --set is ignored", file=sys.stderr)
            inputs = [model]
        else:
            try:
                paths = flatten.flatten_set(a.printer, a.process, fils, a.support, work, a.bed_type, a.prime_tower)
            except flatten.MissingParent as e:
                raise UsageError(f"unknown preset {e} (see orca-slice --list)")
            for w in flatten.WARNINGS:
                print(f"note: {w}", file=sys.stderr)
            proc = json.load(open(paths["process"], encoding="utf-8"))
            machine = json.load(open(paths["machine"], encoding="utf-8"))
            filaments = [json.load(open(p, encoding="utf-8")) for p in paths["filaments"]]
            sets = [parse_set(s) for s in a.set]
            proc["brim_type"] = "no_brim"          # Jonas never wants brims
            if str(proc.get("enable_prime_tower", "0")) == "1":
                # inherited tower spot (x=15) is off this bed (printable x starts at 26)
                proc["wipe_tower_x"], proc["wipe_tower_y"] = "250", "250"
            native = route_sets(sets, catalog, machine, proc, filaments, notes)
            set_keys = {k for k, _, _ in sets}
            if "layer_height" in set_keys and "initial_layer_print_height" not in set_keys:
                lh = flatten._first_num(proc.get("layer_height"))
                if flatten._first_num(proc.get("initial_layer_print_height")) < lh:
                    proc["initial_layer_print_height"] = f"{lh:g}"
            # flattened = self-contained; the fork CLI only resolves `inherits` for
            # presets it loaded itself from <datadir>/user, so drop the link
            for pth, d in [(paths["machine"], machine), (paths["process"], proc)] + list(zip(paths["filaments"], filaments)):
                d.pop("inherits", None)
                json.dump(d, open(pth, "w", encoding="utf-8"), indent=1, ensure_ascii=False)
            cmd += ["--load-settings", paths["machine"] + ";" + paths["process"],
                    "--load-filaments", ";".join(paths["filaments"])] + native
            if mode == "model":
                tf = []
                if a.rotate_x:
                    tf += ["--rotate-x", f"{a.rotate_x:g}"]
                if a.rotate_y:
                    tf += ["--rotate-y", f"{a.rotate_y:g}"]
                if a.rotate:
                    tf += ["--rotate", f"{a.rotate:g}"]
                if a.lay_flat:
                    need_flag("--ground-largest-face", "--lay-flat")
                    tf.append("--ground-largest-face")
                if a.scale:
                    tf += ["--scale", f"{a.scale:g}"]
                cmd += tf + ["--arrange", "0" if a.no_arrange else "1", "--orient", "1" if a.orient else "0"]
                inputs = [model]
            elif mode == "job":
                if isinstance(job, dict):
                    jp = os.path.join(work, "job.json")
                    json.dump(job, open(jp, "w", encoding="utf-8"), indent=1)
                    job = jp
                cmd += ["--load-job", job]
                inputs = []
            else:
                cmd += ["--calib", calib[0]] + (["--calib-params", calib[1]] if calib[1] else [])
                inputs = []
        if not a.no_slice:
            cmd += ["--slice", str(a.plate)]
        elif not (a.export_3mf or a.export_stl or a.export_stls):
            raise UsageError("--no-slice needs an export (--export-3mf, --export-stl, --export-stls)")
        if a.export_3mf:
            cmd += ["--export-3mf", "project.3mf"]
        if a.export_stl:
            cmd.append("--export-stl")
        if a.export_stls:
            cmd += ["--export-stls", os.path.join(outdir, "stls")]
        cmd += ["--outputdir", outdir] + inputs

        t0 = time.time()
        log = os.path.join(work, "orca.log")
        with open(log, "w") as lf:
            rc = subprocess.run(cmd, stdout=lf, stderr=subprocess.STDOUT, env=orca_env(),
                                timeout=a.timeout).returncode
        dt = time.time() - t0
        res = {}
        rj = os.path.join(outdir, "result.json")
        if os.path.exists(rj):
            try:
                res = json.load(open(rj))
            except Exception:
                pass
        warnings = res.get("warnings") or []
        gcodes = sorted(glob.glob(os.path.join(outdir, "plate_*.gcode")) or glob.glob(os.path.join(outdir, "*.gcode")),
                        key=lambda p: int((re.findall(r"(\d+)", os.path.basename(p)) or ["0"])[-1]))
        if rc != 0 or res.get("return_code") not in (0, None) or (not gcodes and not a.no_slice):
            tail = open(log, errors="replace").read().splitlines()[-15:]
            print(f"orca-slice: slice FAILED (exit {rc}, {res.get('error_string', '')})", file=sys.stderr)
            print("\n".join(tail), file=sys.stderr)
            if str(proc.get("draft_shield", "disabled")) == "enabled" \
                    and "inside the print volume" in res.get("error_string", ""):
                print("hint: this process has draft_shield=enabled, which the fork's CLI rejects "
                      "this way (2.3.2 sliced it); retry with --set draft_shield=disabled", file=sys.stderr)
            if warnings:
                print("warnings: " + json.dumps(warnings), file=sys.stderr)
            a.keep_tmp = True
            return 1
        subst = [w for w in warnings if w.get("class") == "config_value_substituted"]
        if subst and not a.allow_substitutions:
            for w in subst:
                entry = (catalog or {}).get(w.get("key"), {})
                allowed = entry.get("enum_values")
                print(f"orca-slice: {w.get('key')}={w.get('old_value')!r} is not valid (the slicer would use "
                      f"{w.get('new_value')!r})" + (f"; allowed: {', '.join(allowed)}" if allowed else "")
                      + (f" [from {os.path.basename(w['file'])}]" if w.get("file") else ""), file=sys.stderr)
            print("orca-slice: refusing a slice with replaced settings (--allow-substitutions to accept)",
                  file=sys.stderr)
            a.keep_tmp = True
            return 2

        multi = len(gcodes) > 1
        plates = []
        for gp in gcodes:
            n = int((re.findall(r"(\d+)", os.path.basename(gp)) or ["1"])[-1])
            dst = os.path.splitext(final)[0] + f"_plate{n}.gcode" if multi else final
            stem_src, stem_dst = os.path.splitext(gp)[0], os.path.splitext(dst)[0]
            entry = {"plate": n, "gcode": dst}
            # fork toolhead clearance check (toolhead_clearance_enable): plate_N.clearance.json
            if os.path.isfile(stem_src + ".clearance.json"):
                try:
                    clearance = json.load(open(stem_src + ".clearance.json"))
                    shutil.move(stem_src + ".clearance.json", stem_dst + ".clearance.json")
                    clearance["report"] = stem_dst + ".clearance.json"
                except Exception as e:
                    clearance = {"ran": False, "error": f"unreadable clearance report: {e}"}
                if clearance.get("collisions"):
                    print(f"orca-slice: WARNING toolhead clearance: {clearance['collisions']} colliding move(s), "
                          f"see {clearance.get('report')}", file=sys.stderr)
                entry["clearance"] = clearance
            shutil.move(gp, dst)
            if a.html:
                if os.path.isfile(stem_src + ".html"):
                    shutil.move(stem_src + ".html", stem_dst + ".html")
                    entry["html"] = stem_dst + ".html"
                else:
                    entry["html"] = None
                    print("orca-slice: the slicer wrote no HTML preview (see --keep-tmp orca.log)", file=sys.stderr)
            if a.stats and os.path.isfile(stem_src + ".statistics.json"):
                shutil.move(stem_src + ".statistics.json", stem_dst + ".statistics.json")
                entry["statistics"] = stem_dst + ".statistics.json"
            if not a.as_is and lane > 1:
                n_re = retool(dst, lane - 1)
                print(f"lane {lane}: retooled {n_re} line(s) T0 -> T{lane - 1} ({os.path.basename(dst)})",
                      file=sys.stderr)
            entry["size_bytes"] = os.path.getsize(dst)
            entry.update(stats(dst))
            plates.append(entry)

        out = {}
        if plates:
            first = plates[0]
            out = {"gcode": first["gcode"], "slice_seconds": round(dt, 1), "size_bytes": first["size_bytes"],
                   **{k: first[k] for k in STAT_KEYS.values() if k in first}}
            if a.html:
                out["html"] = first.get("html")
            if "clearance" in first:
                out["clearance"] = first["clearance"]
            if "statistics" in first:
                out["statistics"] = first["statistics"]
            if multi:
                out["plates"] = plates
        else:
            out = {"gcode": None, "slice_seconds": round(dt, 1)}
        if a.export_3mf:
            src3 = os.path.join(outdir, "project.3mf")
            if os.path.isfile(src3):
                dst3 = os.path.abspath(a.export_3mf)
                os.makedirs(os.path.dirname(dst3), exist_ok=True)
                shutil.move(src3, dst3)
                out["project_3mf"] = dst3
            else:
                print("orca-slice: the slicer wrote no 3MF (see --keep-tmp orca.log)", file=sys.stderr)
                a.keep_tmp = True
                return 1
        if a.export_stl:
            stls = sorted(glob.glob(os.path.join(outdir, "stl", "*.stl")) + glob.glob(os.path.join(outdir, "*.stl")))
            dsts = []
            for i, s in enumerate(stls, 1):
                d = os.path.splitext(final)[0] + (f"_{i}" if len(stls) > 1 else "") + ".stl"
                shutil.move(s, d)
                dsts.append(d)
            out["stl"] = dsts
        if a.export_stls:
            dd = os.path.abspath(a.export_stls)
            os.makedirs(dd, exist_ok=True)
            dsts = []
            for s in sorted(glob.glob(os.path.join(outdir, "stls", "*.stl"))):
                d = os.path.join(dd, os.path.basename(s))
                shutil.move(s, d)
                dsts.append(d)
            out["stls"] = dsts
        if mode == "calib" and isinstance(res.get("calibration"), dict):
            out["calibration"] = res["calibration"]
        if warnings:
            out["warnings"] = warnings
        if notes:
            out["notes"] = notes
            for n in notes:
                print(f"note: {n}", file=sys.stderr)
        print(json.dumps(out, indent=1))
        return 0
    except subprocess.TimeoutExpired:
        print(f"orca-slice: timed out after {a.timeout}s", file=sys.stderr)
        a.keep_tmp = True
        return 1
    finally:
        if a.keep_tmp:
            print(f"work dir kept: {work}", file=sys.stderr)
        else:
            shutil.rmtree(work, ignore_errors=True)


def cmd_job(argv):
    ap = argparse.ArgumentParser(prog="orca-slice job", description="Slice a job file (objects, parts, modifiers, "
                                 "paint, cuts, plates; see the fork's docs/headless-cli.md) with the usual presets.")
    ap.add_argument("jobfile")
    add_slice_args(ap, model_arg=False)
    a = ap.parse_args(argv)
    return run_job(a, a.jobfile)


def run_job(a, path):
    path = os.path.abspath(path)
    if not os.path.isfile(path):
        raise UsageError(f"no such file: {path}")
    for flag in ("set_object", "set_range", "modifier", "negative"):
        if getattr(a, flag):
            raise UsageError(f"--{flag.replace('_', '-')} can't be combined with a job file; put it in the job")
    if a.cut or a.copies or a.orient or a.rotate or a.rotate_x or a.rotate_y or a.lay_flat or a.scale or a.no_arrange:
        raise UsageError("transforms (--cut, --copies, --orient, --rotate*, --lay-flat, --scale, --no-arrange) go in "
                         "the job file")
    try:
        json.load(open(path, encoding="utf-8"))
    except ValueError as e:
        raise UsageError(f"{path}: not valid JSON: {e}")
    return run_slice(a, "job", job=path)


CALIB_MODES = ("pa_line", "pa_pattern", "pa_tower", "flow_rate", "flow_rate_yolo", "temp_tower", "vol_speed", "vfa",
               "retraction", "input_shaping_freq", "input_shaping_damp", "cornering")


def cmd_calib(argv):
    ap = argparse.ArgumentParser(prog="orca-slice calib", description="Calibration prints, as the GUI's Calibration "
                                 "menu makes them (brims stay off). MODE: " + ", ".join(CALIB_MODES) + ". "
                                 "--params takes the fork's --calib-params, e.g. start=270,end=240,step=5.")
    ap.add_argument("mode")
    ap.add_argument("--params", default="", help="k=v,... (start, end, step, pass, print_numbers, speeds, accels, ...)")
    add_slice_args(ap, model_arg=False)
    a = ap.parse_args(argv)
    if a.job or a.set_object or a.set_range or a.modifier or a.negative or a.cut or a.copies:
        raise UsageError("calibration prints take presets and --set only")
    return run_slice(a, "calib", calib=(a.mode, a.params))


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    try:
        if argv and argv[0] in SUBCOMMANDS and not os.path.exists(argv[0]):
            return {"options": cmd_options, "inspect": cmd_inspect, "calib": cmd_calib, "job": cmd_job,
                    "lanes": cmd_lanes, "hub": cmd_hub}[argv[0]](argv[1:])
        ap = argparse.ArgumentParser(
            prog="orca-slice", description=__doc__.split("\n\n")[0],
            epilog=__doc__.split("\n", 2)[2], formatter_class=argparse.RawDescriptionHelpFormatter)
        add_slice_args(ap)
        ap.add_argument("--list", action="store_true", help="list available preset names and exit")
        a = ap.parse_args(argv)
        if a.list:
            list_presets()
            return 0
        if a.job:
            if a.model:
                raise UsageError("give either a model or --job")
            return run_job(a, a.job)
        if not a.model:
            ap.error("model is required (or use --list)")
        model = os.path.abspath(a.model)
        if not os.path.isfile(model):
            ap.error(f"no such file: {a.model}")
        if model.lower().endswith(".json"):
            return run_job(a, model)
        return run_slice(a, "model", model=model)
    except UsageError as e:
        fail(str(e), 2)


if __name__ == "__main__":
    sys.exit(main())
